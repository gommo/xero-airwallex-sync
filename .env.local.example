# Airwallex API (read-only key is fine for sync)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.airwallex.com

# Stripe (read-only restricted key, rk_live_… ; needs Balance/Transactions, Connect, Charges read)
STRIPE_API_READONLY_KEY=
STRIPE_BASE_URL=https://api.stripe.com

# Xero OAuth2 (filled in later — leave blank for now)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# Local state
DB_PATH=./data/sync.db
LOG_LEVEL=info

# Pushover notifications (used by scripts/run-sync.sh)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=

# Stripe -> Xero posting targets (fill from your Xero org)
STRIPE_BANK_ACCOUNT_ID=
STRIPE_TRACKING_CATEGORY_ID=
STRIPE_TRACKING_OPTION_ID=
STRIPE_CODE_SUBSCRIPTIONS=
STRIPE_CODE_SPONSORSHIP=
STRIPE_CODE_TICKETING=
STRIPE_CODE_FEES=
STRIPE_SPONSORSHIP_PRODUCT_ID=
STRIPE_CODE_CLEARING=
STRIPE_CODE_RESERVE=
# Optional: account for the rate difference on Stripe currency conversions (defaults to STRIPE_CODE_FEES)
STRIPE_CODE_FX=

# PayPal Transaction Search (Live REST app with "Transaction Search" enabled)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.paypal.com
PAYPAL_BANK_ACCOUNT_ID=          # Xero bank account id for the AUD-denominated PayPal USD account
PAYPAL_PATREON_CODE=             # revenue account code for Patreon payouts
PAYPAL_TRACKING_CATEGORY_ID=
PAYPAL_TRACKING_OPTION_ID=
PAYPAL_POST_FROM=                # YYYY-MM-DD; payouts before this are never posted
