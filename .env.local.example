# Airwallex API (read-only key is fine for sync)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=https://api.airwallex.com

# Xero OAuth2 (filled in later — leave blank for now)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=

# Local state
DB_PATH=./data/sync.db
LOG_LEVEL=info

# Pushover notifications (used by scripts/run-sync.sh)
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
