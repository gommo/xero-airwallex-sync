<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tributech.xero-airwallex-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/colin/dev/tributech/clients/xero-airwallex-sync/scripts/run-sync.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/colin/dev/tributech/clients/xero-airwallex-sync</string>

  <!-- Run daily at 07:15 local time. Adjust Hour/Minute to taste. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <!-- If the laptop was asleep at fire time, run on next wake. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/colin/dev/tributech/clients/xero-airwallex-sync/data/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/colin/dev/tributech/clients/xero-airwallex-sync/data/launchd.err.log</string>
</dict>
</plist>
